{
  "name": "noir-ai-observatory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A repository-first observatory for AI releases, research, APIs, and model behavior.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "build": "corepack pnpm generate:sources && corepack pnpm generate:dashboard && corepack pnpm generate:health && corepack pnpm generate:research && corepack pnpm --filter @noir/web build",
    "category:add": "node --import tsx scripts/registry-cli.ts category:add",
    "category:edit": "node --import tsx scripts/registry-cli.ts category:edit",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm observations:validate && corepack pnpm health:validate && corepack pnpm research:validate && corepack pnpm build",
    "collect": "node --import tsx scripts/collect.ts",
    "dev": "corepack pnpm generate:sources && corepack pnpm generate:dashboard && corepack pnpm generate:health && corepack pnpm generate:research && corepack pnpm --filter @noir/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:activity": "node --import tsx scripts/generate-activity.ts",
    "generate:dashboard": "node --import tsx scripts/generate-dashboard.ts",
    "generate:health": "node --import tsx scripts/generate-health.ts",
    "generate:research": "node --import tsx scripts/generate-research.ts",
    "generate:sources": "node --import tsx scripts/generate-sources.ts",
    "lint": "eslint . --max-warnings 0",
    "health:run": "node --import tsx scripts/monitor-health.ts",
    "health:validate": "node --import tsx scripts/validate-health.ts",
    "monitor:add": "node --import tsx scripts/monitor-cli.ts monitor:add",
    "monitor:check": "node --import tsx scripts/monitor-cli.ts monitor:check",
    "monitor:disable": "node --import tsx scripts/monitor-cli.ts monitor:disable",
    "monitor:edit": "node --import tsx scripts/monitor-cli.ts monitor:edit",
    "monitor:enable": "node --import tsx scripts/monitor-cli.ts monitor:enable",
    "monitor:list": "node --import tsx scripts/monitor-cli.ts monitor:list",
    "monitor:request": "node --import tsx scripts/monitor-request.ts",
    "monitor:validate": "node --import tsx scripts/monitor-cli.ts monitor:validate",
    "observations:validate": "node --import tsx scripts/validate-observations.ts",
    "research:collect": "node --import tsx scripts/collect-research.ts",
    "research:validate": "node --import tsx scripts/validate-research.ts",
    "research-source:add": "node --import tsx scripts/research-cli.ts research-source:add",
    "research-source:check": "node --import tsx scripts/research-cli.ts research-source:check",
    "research-source:disable": "node --import tsx scripts/research-cli.ts research-source:disable",
    "research-source:edit": "node --import tsx scripts/research-cli.ts research-source:edit",
    "research-source:enable": "node --import tsx scripts/research-cli.ts research-source:enable",
    "research-source:list": "node --import tsx scripts/research-cli.ts research-source:list",
    "research-source:request": "node --import tsx scripts/research-request.ts",
    "research-source:validate": "node --import tsx scripts/research-cli.ts research-source:validate",
    "registry:validate": "node --import tsx scripts/registry-cli.ts registry:validate",
    "source:add": "node --import tsx scripts/registry-cli.ts source:add",
    "source:check": "node --import tsx scripts/registry-cli.ts source:check",
    "source:disable": "node --import tsx scripts/registry-cli.ts source:disable",
    "source:edit": "node --import tsx scripts/registry-cli.ts source:edit",
    "source:enable": "node --import tsx scripts/registry-cli.ts source:enable",
    "source:list": "node --import tsx scripts/registry-cli.ts source:list",
    "source:request": "node --import tsx scripts/source-request.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "corepack pnpm -r --if-present typecheck && tsc --project tsconfig.scripts.json"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
